# ===== 服务配置 =====
PORT=3005

# ===== 管理后台登录密码（登录接口校验，不进入前端构建产物）=====
# 生成方式：openssl rand -base64 18
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== DeepSeek API =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 微信小程序（云开发 TCB）=====
WX_APPID=wx0000000000000000
WX_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TCB_ENV=your-cloud-env-id

# ===== 腾讯云 COS（export_pdf / export_to_desktop 脚本使用）=====
COS_ENV=your-cos-env-id
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== TOF 网关直连（tof_api/ 使用，兑现申请单据查询）=====
# 二选一（优先级：TOF_AUTH_JSON > TOF_BEARER_TOKEN）：
#   TOF_AUTH_JSON   指向 xfz-survey/auth.json（含 token + cookie）
#   TOF_BEARER_TOKEN 浏览器 devtools 里 Authorization 头的值（带不带 bearer 前缀均可）
# access token 几小时过期，过期后更新其中一个即可
TOF_AUTH_JSON=
TOF_BEARER_TOKEN=
